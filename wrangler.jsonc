{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "gif2sticker",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    // Only files in public/ are deployed; everything else in the repo stays private.
    "directory": "./public",
    "binding": "ASSETS",
    // Only the link service runs the Worker; every other request is a free static-asset request.
    "run_worker_first": ["/api/*"]
  },
  // Per visitor IP, per Cloudflare location: plenty for a person, useless for a script.
  "ratelimits": [{ "name": "LINK_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  // Preview deployments (PR builds run `wrangler preview`) get their own counters, separate from production.
  "previews": {
    "ratelimits": [{ "name": "LINK_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }]
  }
}
